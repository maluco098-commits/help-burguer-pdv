{
  "name": "help-burguer-pdv",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev -w @help-burguer/api\" \"npm:dev -w @help-burguer/web\"",
    "build": "npm run build -w @help-burguer/api && npm run build -w @help-burguer/web",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start:render": "npm run db:deploy && npm run db:seed && npm run start -w @help-burguer/api",
    "test": "npm run test -w @help-burguer/api",
    "db:studio": "prisma studio"
  },
  "devDependencies": { "concurrently": "^9.1.2", "prisma": "^6.5.0", "typescript": "^5.7.3" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
